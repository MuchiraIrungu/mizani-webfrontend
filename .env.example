# Google OAuth 2.0 Web client ID (Google Cloud Console → Credentials).
# Add http://localhost:5173 to "Authorised JavaScript origins".
VITE_GOOGLE_CLIENT_ID=

# Backend route that exchanges the Google auth code for a session cookie.
# POST { code, redirect_uri: "postmessage" } → sets httpOnly session cookie.
VITE_AUTH_ENDPOINT=/api/auth/google
